# Configuration Serveur
PORT=4000
NODE_ENV=development

# Type de base de données : 'embedded' (PGlite local) ou 'postgres'
# Note : si DATABASE_TYPE n'est pas forcé à 'embedded' et que POSTGRES_URL ou DATABASE_URL
# commence par postgres:// / postgresql://, le backend bascule automatiquement en mode 'postgres'.
DATABASE_TYPE=embedded
PGLITE_DATA_DIR=./data/pglite

# Si DATABASE_TYPE=postgres (ou Neon / Supabase via Vercel Marketplace) :
DATABASE_URL=postgresql://restogest_app:app_secure_password@localhost:5432/restogest
DATABASE_ADMIN_URL=postgresql://restogest_admin:admin_secure_password@localhost:5432/restogest

# Clés de sécurité JWT
JWT_SECRET=super_secret_jwt_key_restogest_v1_change_in_production
JWT_EXPIRES_IN=24h
