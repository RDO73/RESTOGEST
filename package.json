{
  "name": "restogest-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API REST & moteur métier multi-tenant pour RestoGest V1",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('node:fs'); fs.cpSync('src/schema', 'dist/schema', { recursive: true }); fs.cpSync('src/public', 'dist/public', { recursive: true });\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:schema": "node tests/validate_restogest.mjs",
    "test:concurrency": "node tests/concurrency_pg.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "restogest",
    "saas",
    "restaurant",
    "pos",
    "inventory",
    "postgresql",
    "rls"
  ],
  "author": "RestoGest Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neon/config": "^1.14.1",
    "@neon/env": "^2.1.4",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
